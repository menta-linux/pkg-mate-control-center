diff --git a/typing-break/meson.build b/typing-break/meson.build
index 29033b9..8d36cf2 100644
--- a/typing-break/meson.build
+++ b/typing-break/meson.build
@@ -13,17 +13,42 @@ deps = [
   m_dep
 ]
 deps += [appindicator_dep,ayatana_dep]
+
+sources = [
+  'drw-break-window.c',
+  'drw-monitor.c',
+  'drwright.c',
+  'drw-selection.c',
+  'drw-timer.c',
+  'drw-utils.c',
+  'main.c'
+]
+
+# Typing activity on Wayland comes from the compositor (ext-idle-notify-v1)
+wayland_client_dep = dependency('wayland-client', required : false)
+gtk_wayland_dep = dependency('gtk+-wayland-3.0', required : false)
