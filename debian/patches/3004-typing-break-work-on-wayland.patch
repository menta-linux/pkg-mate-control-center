+
+/* How often the idle state is checked, in seconds */
+#define POLL_INTERVAL 3
 
 struct _DrwMonitorPriv {
 	XScreenSaverInfo *ss_info;
@@ -41,6 +47,9 @@ struct _DrwMonitorPriv {
 	unsigned long     last_idle;
 
 	time_t            last_activity;
+#ifdef HAVE_WAYLAND_IDLE
+	DrwIdleWayland   *wl_idle;
+#endif
 };
 
 /* Signals */
@@ -122,12 +131,17 @@ drw_monitor_finalize (GObject *object)
 
         priv = monitor->priv;
 
-	g_source_remove (priv->timeout_id);
-	priv->timeout_id = 0;
+	if (priv->timeout_id != 0) {
+		g_source_remove (priv->timeout_id);
+		priv->timeout_id = 0;
+	}
 
 	if (priv->ss_info) {
 		XFree (priv->ss_info);
 	}
+#ifdef HAVE_WAYLAND_IDLE
+	drw_idle_wayland_free (priv->wl_idle);
+#endif
 
 	g_free (priv);
 	monitor->priv = NULL;
@@ -145,6 +159,25 @@ drw_monitor_timeout (DrwMonitor *monitor)
 
 	priv = monitor->priv;
 
+#ifdef HAVE_WAYLAND_IDLE
+	if (priv->wl_idle != NULL) {
+		/* The compositor says "idle" after POLL_INTERVAL seconds without
+		 * input, so not idle means there was input since the last check:
+		 * the same as the X idle time going down. */
+		if (!drw_idle_wayland_is_idle (priv->wl_idle)) {
+			now = time (NULL);
+
+			if (now - priv->last_activity < 25) {
+				g_signal_emit (monitor, signals[ACTIVITY], 0, NULL);
+			}
+
+			priv->last_activity = now;
+		}
+
+		return TRUE;
+	}
+#endif
+
 	if (XScreenSaverQueryInfo (GDK_DISPLAY_XDISPLAY(gdk_display_get_default()), DefaultRootWindow (GDK_DISPLAY_XDISPLAY(gdk_display_get_default())), priv->ss_info) != 0) {
 		if (priv->ss_info->idle < priv->last_idle) {
  			now = time (NULL);
@@ -162,6 +195,18 @@ drw_monitor_timeout (DrwMonitor *monitor)
 	return TRUE;
 }
 
+static gboolean
+start_wayland_idle (DrwMonitorPriv *priv)
+{
+#ifdef HAVE_WAYLAND_IDLE
+	priv->wl_idle = drw_idle_wayland_new (POLL_INTERVAL * 1000);
+
+	return priv->wl_idle != NULL;
+#else
+	return FALSE;
+#endif
+}
+
 static gboolean
 drw_monitor_setup (DrwMonitor *monitor)
 {
@@ -171,6 +216,20 @@ drw_monitor_setup (DrwMonitor *monitor)
 
 	priv = monitor->priv;
 
+	if (!GDK_IS_X11_DISPLAY (gdk_display_get_default ())) {
+		/* No X screensaver extension: ask the Wayland compositor. */
+		if (!start_wayland_idle (priv)) {
+			g_message ("Typing activity can't be monitored: no X server, "
+				   "and the compositor offers no ext-idle-notify-v1");
+			return FALSE;
+		}
+
+		priv->last_activity = time (NULL);
+		priv->timeout_id = g_timeout_add_seconds (POLL_INTERVAL, (GSourceFunc) drw_monitor_timeout, monitor);
+
+		return TRUE;
+	}
+
 	if (!XScreenSaverQueryExtension (GDK_DISPLAY_XDISPLAY(gdk_display_get_default()), &event_base, &error_base)) {
 		return FALSE;
 	}
@@ -179,7 +238,7 @@ drw_monitor_setup (DrwMonitor *monitor)
 
 	priv->last_activity = time (NULL);
 
-	priv->timeout_id = g_timeout_add_seconds (3, (GSourceFunc) drw_monitor_timeout, monitor);
+	priv->timeout_id = g_timeout_add_seconds (POLL_INTERVAL, (GSourceFunc) drw_monitor_timeout, monitor);
 
 	return TRUE;
 }
diff --git a/typing-break/drw-selection.c b/typing-break/drw-selection.c
index 3145440..d6a525f 100644
--- a/typing-break/drw-selection.c
+++ b/typing-break/drw-selection.c
@@ -31,8 +31,12 @@ struct _DrwSelection
 {
 	GdkWindow *owner_window;
 	GtkWidget *invisible;
+	GDBusConnection *bus; /* off X11: holds the single instance name */
+	gboolean   is_master;
 };
 
+#define INSTANCE_BUS_NAME "org.mate.TypingMonitor"
+
 #define SELECTION_NAME "_CODEFACTORY_DRWRIGHT"
 
 static GdkFilterReturn drw_selection_filter     (GdkXEvent   *xevent,
@@ -166,13 +170,46 @@ drw_selection_filter (GdkXEvent *xevent,
 	return GDK_FILTER_CONTINUE;
 }
 
+/* There is no X selection to claim on Wayland: use a session bus name. */
+static void
+drw_selection_claim_bus_name (DrwSelection *drw_selection)
+{
+	GVariant *reply;
+
+	/* No bus: nothing to arbitrate with, so run as the only instance. */
+	drw_selection->is_master = TRUE;
+	drw_selection->bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, NULL);
+	if (drw_selection->bus == NULL)
+		return;
+
+	/* RequestName with DBUS_NAME_FLAG_DO_NOT_QUEUE (4); reply 1 is primary owner */
+	reply = g_dbus_connection_call_sync (drw_selection->bus,
+					     "org.freedesktop.DBus",
+					     "/org/freedesktop/DBus",
+					     "org.freedesktop.DBus",
+					     "RequestName",
+					     g_variant_new ("(su)", INSTANCE_BUS_NAME, 4),
+					     G_VARIANT_TYPE ("(u)"),
+					     G_DBUS_CALL_FLAGS_NONE,
+					     -1, NULL, NULL);
+	if (reply != NULL) {
+		guint32 result;
+
+		g_variant_get (reply, "(u)", &result);
+		drw_selection->is_master = (result == 1 || result == 4);
+		g_variant_unref (reply);
+	}
+}
+
 DrwSelection *
 drw_selection_start (void)
 {
-	DrwSelection *drw_selection = g_new (DrwSelection, 1);
+	DrwSelection *drw_selection = g_new0 (DrwSelection, 1);
 
-	drw_selection->owner_window = NULL;
-	drw_selection->invisible = NULL;
+	if (!GDK_IS_X11_DISPLAY (gdk_display_get_default ())) {
+		drw_selection_claim_bus_name (drw_selection);
+		return drw_selection;
+	}
 
 	drw_selection_negotiate (drw_selection);
 
@@ -183,11 +220,15 @@ void
 drw_selection_stop (DrwSelection *drw_selection)
 {
 	drw_selection_reset (drw_selection);
+	g_clear_object (&drw_selection->bus);
 	g_free (drw_selection);
 }
 
 gboolean
 drw_selection_is_master (DrwSelection *drw_selection)
 {
+	if (drw_selection->bus != NULL || drw_selection->is_master)
+		return drw_selection->is_master;
+
 	return drw_selection->invisible != NULL;
 }
diff --git a/typing-break/drw-utils.c b/typing-break/drw-utils.c
index c70806a..52a13c0 100644
--- a/typing-break/drw-utils.c
