 }
 
+/* Which of Super, Hyper and Meta are modifiers of their own, from the X server */
 static void
-reload_mouse_modifiers (void)
+get_x11_modifiers (gboolean *have_super_out,
+                   gboolean *have_hyper_out,
+                   gboolean *have_meta_out)
 {
     XModifierKeymap *modmap;
     KeySym *keymap;
@@ -604,7 +647,6 @@ reload_mouse_modifiers (void)
     gboolean have_super;
     int min_keycode, max_keycode;
     int mod_meta, mod_super, mod_hyper;
-    AtkObject *label_accessible;
 
     XDisplayKeycodes (gdk_x11_display_get_xdisplay(gdk_display_get_default()),
                       &min_keycode,
@@ -662,6 +704,50 @@ reload_mouse_modifiers (void)
     XFreeModifiermap (modmap);
     XFree (keymap);
 
+    *have_super_out = have_super;
+    *have_hyper_out = have_hyper;
+    *have_meta_out = have_meta;
+}
+
+static void
+get_keymap_modifiers (gboolean *have_super,
+                      gboolean *have_hyper,
+                      gboolean *have_meta)
+{
+    const GdkModifierType real = GDK_MOD1_MASK | GDK_MOD2_MASK | GDK_MOD3_MASK |
+                                 GDK_MOD4_MASK | GDK_MOD5_MASK;
+    GdkKeymap *keymap = gdk_keymap_get_for_display (gdk_display_get_default ());
+    GdkModifierType super = GDK_SUPER_MASK;
+    GdkModifierType hyper = GDK_HYPER_MASK;
+    GdkModifierType meta = GDK_META_MASK;
+
+    gdk_keymap_map_virtual_modifiers (keymap, &super);
+    gdk_keymap_map_virtual_modifiers (keymap, &hyper);
+    gdk_keymap_map_virtual_modifiers (keymap, &meta);
+    super &= real;
+    hyper &= real;
+    meta &= real;
+
+    /* Meta on Alt's modifier is just Alt */
+    *have_meta = meta != 0 && meta != GDK_MOD1_MASK;
+    *have_super = super != 0 && super != meta;
+    *have_hyper = hyper != 0 && hyper != meta && hyper != super;
+}
+
+static void
+reload_mouse_modifiers (void)
+{
+    int i;
+    gboolean have_meta;
+    gboolean have_hyper;
+    gboolean have_super;
+    AtkObject *label_accessible;
+
+    if (GDK_IS_X11_DISPLAY (gdk_display_get_default ()))
+        get_x11_modifiers (&have_super, &have_hyper, &have_meta);
+    else
+        get_keymap_modifiers (&have_super, &have_hyper, &have_meta);
+
     i = 0;
     while (i < n_mouse_modifiers) {
         g_free (mouse_modifiers[i].name);
