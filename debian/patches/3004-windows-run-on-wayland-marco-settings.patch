     }
 }
 
+/* Without X there is no window manager to ask. Some Wayland compositors
+ * read the same org.mate.Marco.* settings as Marco; they own this name on
+ * the session bus while they run. */
+static gboolean
+compositor_uses_marco_settings (void)
+{
+    GDBusConnection *bus;
+    GVariant *reply;
+    gboolean running = FALSE;
+
+    bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, NULL);
+    if (bus == NULL)
+        return FALSE;
+
+    reply = g_dbus_connection_call_sync (bus,
+                                         "org.freedesktop.DBus",
+                                         "/org/freedesktop/DBus",
+                                         "org.freedesktop.DBus",
+                                         "NameHasOwner",
+                                         g_variant_new ("(s)", "org.mate.Polo"),
+                                         G_VARIANT_TYPE ("(b)"),
+                                         G_DBUS_CALL_FLAGS_NONE,
+                                         1000, NULL, NULL);
+    if (reply != NULL) {
+        g_variant_get (reply, "(b)", &running);
+        g_variant_unref (reply);
+    }
+    g_object_unref (bus);
+
+    return running;
+}
+
 static void
 wm_unsupported (void)
 {
@@ -402,14 +434,20 @@ main (int argc, char **argv)
     capplet_init (NULL, &argc, &argv);
 
     screen = gdk_display_get_default_screen (gdk_display_get_default ());
-    current_wm = gdk_x11_screen_get_window_manager_name (screen);
 
