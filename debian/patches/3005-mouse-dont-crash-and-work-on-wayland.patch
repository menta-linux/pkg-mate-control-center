Description: mouse: do not crash and list devices over D-Bus on Wayland (mate-mouse-properties SIGSEGV); hide Sensitivity where libinput drives the devices
Author: Kerem Soke
Origin: upstream, https://github.com/mate-desktop/mate-control-center/pull/842
Forwarded: https://github.com/mate-desktop/mate-control-center/pull/842

From 903241a7c121d24580e1bc09a3c4c1a0bf4b1218 Mon Sep 17 00:00:00 2001
From: KeremSoke <keremsoke@gmail.com>
Date: Fri, 13 Nov 2026 19:42:44 -0700
Subject: [PATCH 1/2] mouse: don't crash and list devices over D-Bus on Wayland

---
 capplets/mouse/mate-mouse-properties.c |  20 ++++-
 capplets/mouse/msd-input-helper.c      | 120 +++++++++++++++++++++++++
 capplets/mouse/msd-input-helper.h      |   2 +
 3 files changed, 138 insertions(+), 4 deletions(-)

diff --git a/capplets/mouse/mate-mouse-properties.c b/capplets/mouse/mate-mouse-properties.c
index 15e812925..f3acf21b3 100644
--- a/capplets/mouse/mate-mouse-properties.c
+++ b/capplets/mouse/mate-mouse-properties.c
@@ -171,6 +171,14 @@ orientation_radio_button_toggled (GtkToggleButton *togglebutton,
 	g_settings_set_boolean (mouse_settings, "left-handed", left_handed);
 }
 
+/* A touchpad without a physical left button needs tap-to-click */
+static void
+force_tap_to_click (GtkBuilder *dialog)
+{
+	gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (gtk_builder_get_object (dialog, "tap_to_click_toggle")), TRUE);
+	gtk_widget_set_sensitive (WID ("tap_to_click_toggle"), FALSE);
+}
+
 static void
 synaptics_check_capabilities (GtkBuilder *dialog)
 {
@@ -183,6 +191,12 @@ synaptics_check_capabilities (GtkBuilder *dialog)
 	unsigned char *data;
 
 	display = gdk_display_get_default ();
+	if (!GDK_IS_X11_DISPLAY (display)) {
+		if (touchpad_lacks_left_button ())
+			force_tap_to_click (dialog);
+		return;
+	}
+
 	prop = XInternAtom (GDK_DISPLAY_XDISPLAY(display), "Synaptics Capabilities", True);
 	if (!prop)
 		return;
@@ -204,10 +218,8 @@ synaptics_check_capabilities (GtkBuilder *dialog)
 					 &bytes_after, &data) == Success) && (realtype != None)) {
 			/* Property data is booleans for has_left, has_middle,
 			 * has_right, has_double, has_triple */
-			if (!data[0]) {
-				gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (gtk_builder_get_object (dialog, "tap_to_click_toggle")), TRUE);
-				gtk_widget_set_sensitive (WID ("tap_to_click_toggle"), FALSE);
-			}
+			if (!data[0])
+				force_tap_to_click (dialog);
 
 			XFree (data);
 		}
diff --git a/capplets/mouse/msd-input-helper.c b/capplets/mouse/msd-input-helper.c
index 7dc0d996c..460023474 100644
--- a/capplets/mouse/msd-input-helper.c
+++ b/capplets/mouse/msd-input-helper.c
@@ -22,12 +22,129 @@
 
 #include <gdk/gdk.h>
 #include <gdk/gdkx.h>
+#include <gio/gio.h>
 
 #include <sys/types.h>
 #include <X11/Xatom.h>
 
 #include "msd-input-helper.h"
 
+/*
+ * Input devices without X
+ *
+ * Outside X11 (on Wayland) a client cannot list input devices; the compositor
+ * owns them. The session's compositor, or any other service that owns the
+ * input devices, can describe them on the session bus:
+ *
+ *   Bus name   org.mate.InputDevices
+ *   Object     /org/mate/InputDevices
+ *   Interface  org.mate.InputDevices1
+ *
+ *   GetDevices () -> (aa{sv} devices)
+ *     One dictionary per device:
+ *       "name"             s  human readable name
+ *       "type"             s  "keyboard", "pointer", "touchpad", "touchscreen",
+ *                             "tablet" or "other"
+ *       "has-left-button"  b  pointers and touchpads: whether the device can
+ *                             click with a left button (a clickpad can, as its
+ *                             surface clicks); false on a touchpad that can
+ *                             only tap
+ *     Unknown keys are ignored, so the list can grow.
+ *
+ * When nobody provides it the capplet behaves as on an X server without
+ * XInput: it assumes a touchpad may be present.
+ */
+#define INPUT_DEVICES_BUS_NAME  "org.mate.InputDevices"
+#define INPUT_DEVICES_PATH      "/org/mate/InputDevices"
+#define INPUT_DEVICES_INTERFACE "org.mate.InputDevices1"
+
+/* The devices as an aa{sv}, or NULL when nobody describes them. */
+static GVariant *
+input_devices_get (void)
+{
+        GDBusConnection *bus;
+        GVariant *reply;
+        GVariant *devices = NULL;
+
+        bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, NULL);
+        if (bus == NULL)
+                return NULL;
+
+        reply = g_dbus_connection_call_sync (bus,
+                                             INPUT_DEVICES_BUS_NAME,
+                                             INPUT_DEVICES_PATH,
+                                             INPUT_DEVICES_INTERFACE,
+                                             "GetDevices",
+                                             NULL,
+                                             G_VARIANT_TYPE ("(aa{sv})"),
+                                             G_DBUS_CALL_FLAGS_NO_AUTO_START,
+                                             1000, NULL, NULL);
+        if (reply != NULL) {
+                devices = g_variant_get_child_value (reply, 0);
+                g_variant_unref (reply);
+        }
+        g_object_unref (bus);
+
+        return devices;
+}
+
+static gboolean
+device_is_of_type (GVariant   *device,
+                   const char *type)
+{
+        const char *device_type;
+
+        return g_variant_lookup (device, "type", "&s", &device_type) &&
+               g_strcmp0 (device_type, type) == 0;
+}
+
+/* Without X: whether a touchpad is listed; TRUE when nobody lists devices. */
+static gboolean
+input_devices_have_touchpad (void)
+{
+        GVariant *devices, *device;
+        GVariantIter iter;
+        gboolean found = FALSE;
+
+        devices = input_devices_get ();
+        if (devices == NULL)
+                return TRUE;
+
+        g_variant_iter_init (&iter, devices);
+        while (!found && (device = g_variant_iter_next_value (&iter)) != NULL) {
+                found = device_is_of_type (device, "touchpad");
+                g_variant_unref (device);
+        }
+        g_variant_unref (devices);
+
+        return found;
+}
+
+gboolean
+touchpad_lacks_left_button (void)
+{
+        GVariant *devices, *device;
+        GVariantIter iter;
+        gboolean lacks = FALSE;
+
+        devices = input_devices_get ();
+        if (devices == NULL)
+                return FALSE;
+
+        g_variant_iter_init (&iter, devices);
+        while (!lacks && (device = g_variant_iter_next_value (&iter)) != NULL) {
+                gboolean has_left_button;
+
+                if (device_is_of_type (device, "touchpad") &&
+                    g_variant_lookup (device, "has-left-button", "b", &has_left_button))
+                        lacks = !has_left_button;
+                g_variant_unref (device);
+        }
+        g_variant_unref (devices);
+
+        return lacks;
+}
+
 gboolean
 supports_xinput_devices (void)
 {
@@ -100,6 +217,9 @@ touchpad_is_present (void)
         guint i;
         gboolean retval;
 
+        if (!GDK_IS_X11_DISPLAY (gdk_display_get_default ()))
+                return input_devices_have_touchpad ();
+
         if (supports_xinput_devices () == FALSE)
                 return TRUE;
 
diff --git a/capplets/mouse/msd-input-helper.h b/capplets/mouse/msd-input-helper.h
index e46c97e1b..294a42d41 100644
--- a/capplets/mouse/msd-input-helper.h
+++ b/capplets/mouse/msd-input-helper.h
@@ -30,6 +30,8 @@ G_BEGIN_DECLS
 gboolean  supports_xinput_devices (void);
 XDevice  *device_is_touchpad      (XDeviceInfo *deviceinfo);
 gboolean  touchpad_is_present     (void);
+/* Without X: whether a listed touchpad cannot click (tap only) */
+gboolean  touchpad_lacks_left_button (void);
 
 G_END_DECLS
 

From 8c1af79b8b496e3067b81b9bfcd5b2fecf82338a Mon Sep 17 00:00:00 2001
From: KeremSoke <keremsoke@gmail.com>
Date: Fri, 13 Nov 2026 19:42:44 -0700
