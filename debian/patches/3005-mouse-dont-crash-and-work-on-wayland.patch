---
 capplets/mouse/mate-mouse-properties.c | 10 ++++
 capplets/mouse/msd-input-helper.c      | 73 ++++++++++++++++++++++++++
 capplets/mouse/msd-input-helper.h      |  2 +
 3 files changed, 85 insertions(+)

diff --git a/capplets/mouse/mate-mouse-properties.c b/capplets/mouse/mate-mouse-properties.c
index f3acf21b3..17c6875f2 100644
--- a/capplets/mouse/mate-mouse-properties.c
+++ b/capplets/mouse/mate-mouse-properties.c
@@ -320,6 +320,12 @@ setup_dialog (GtkBuilder *dialog)
 	                 gtk_range_get_adjustment (GTK_RANGE (gtk_builder_get_object (dialog, "sensitivity_scale"))), "value",
 	                 G_SETTINGS_BIND_DEFAULT);
 
+	/* Hide the threshold where libinput drives the mice: it has none */
+	if (pointer_threshold_ignored (FALSE)) {
+		gtk_widget_hide (WID ("sensitivity_label"));
+		gtk_widget_hide (WID ("hbox3"));
+	}
+
 	g_signal_connect (WID ("mouse_accel_profile"), "changed",
 			  G_CALLBACK (accel_profile_combobox_changed_callback),
 	                  NULL);
@@ -395,6 +401,10 @@ setup_dialog (GtkBuilder *dialog)
 		g_settings_bind (touchpad_settings, "motion-threshold",
 		                 gtk_range_get_adjustment (GTK_RANGE (gtk_builder_get_object (dialog, "touchpad_sensitivity_scale"))), "value",
 		                 G_SETTINGS_BIND_DEFAULT);
+		if (pointer_threshold_ignored (TRUE)) {
+			gtk_widget_hide (WID ("touchpad_sensitivity_label"));
+			gtk_widget_hide (WID ("hbox31"));
+		}
 
 		synaptics_check_capabilities (dialog);
 	}
diff --git a/capplets/mouse/msd-input-helper.c b/capplets/mouse/msd-input-helper.c
index 460023474..df6412c72 100644
--- a/capplets/mouse/msd-input-helper.c
+++ b/capplets/mouse/msd-input-helper.c
@@ -24,6 +24,7 @@
 #include <gdk/gdkx.h>
 #include <gio/gio.h>
 
+#include <string.h>
 #include <sys/types.h>
 #include <X11/Xatom.h>
 
@@ -209,6 +210,78 @@ device_is_touchpad (XDeviceInfo *deviceinfo)
         return NULL;
 }
 
+static gboolean
+device_is_driven_by_libinput (XDeviceInfo *deviceinfo)
+{
+        GdkDisplay *display = gdk_display_get_default ();
+        XDevice *device;
+        gboolean libinput;
+
+        /* Xwayland's devices stand for the compositor's, which use libinput */
+        if (g_str_has_prefix (deviceinfo->name, "xwayland-"))
+                return TRUE;
+
+        gdk_x11_display_error_trap_push (display);
+        device = XOpenDevice (GDK_DISPLAY_XDISPLAY (display), deviceinfo->id);
+        if (gdk_x11_display_error_trap_pop (display) || (device == NULL))
+                return FALSE;
+
+        /* xf86-input-libinput sets this on every device it drives */
+        libinput = device_has_property (device, "libinput Send Events Modes Available");
+        XCloseDevice (GDK_DISPLAY_XDISPLAY (display), device);
+
+        return libinput;
+}
+
+/*
+ * libinput has no motion threshold, only an acceleration speed and profile,
+ * so the threshold setting does nothing for devices it drives: always outside
+ * X11, and under X11 with xf86-input-libinput. Under X11 the answer is TRUE
+ * only when there is at least one such pointer and all of them use libinput;
+ * a device on evdev or synaptics still honours the threshold.
+ */
+gboolean
+pointer_threshold_ignored (gboolean touchpads)
+{
+        GdkDisplay *display = gdk_display_get_default ();
+        Atom touchpad_type;
+        XDeviceInfo *device_info;
+        gint n_devices, i;
+        gint n_matching = 0;
+        gboolean all_libinput = TRUE;
+
+        if (!GDK_IS_X11_DISPLAY (display))
+                return TRUE;
+
+        if (supports_xinput_devices () == FALSE)
+                return FALSE;
+
+        touchpad_type = XInternAtom (GDK_DISPLAY_XDISPLAY (display), XI_TOUCHPAD, True);
+        device_info = XListInputDevices (GDK_DISPLAY_XDISPLAY (display), &n_devices);
+        if (device_info == NULL)
+                return FALSE;
+
+        for (i = 0; i < n_devices && all_libinput; i++) {
+                gboolean is_touchpad;
+
+                if (device_info[i].use != IsXExtensionPointer)
+                        continue;
+                /* The XTEST pointer is a virtual device of the X server */
+                if (strstr (device_info[i].name, "XTEST") != NULL)
+                        continue;
+
+                is_touchpad = touchpad_type != None && device_info[i].type == touchpad_type;
+                if (is_touchpad != touchpads)
+                        continue;
+
+                n_matching++;
+                all_libinput = device_is_driven_by_libinput (&device_info[i]);
+        }
+        XFreeDeviceList (device_info);
+
+        return n_matching > 0 && all_libinput;
+}
+
 gboolean
 touchpad_is_present (void)
 {
diff --git a/capplets/mouse/msd-input-helper.h b/capplets/mouse/msd-input-helper.h
index 294a42d41..416a80e53 100644
--- a/capplets/mouse/msd-input-helper.h
+++ b/capplets/mouse/msd-input-helper.h
@@ -32,6 +32,8 @@ XDevice  *device_is_touchpad      (XDeviceInfo *deviceinfo);
 gboolean  touchpad_is_present     (void);
 /* Without X: whether a listed touchpad cannot click (tap only) */
 gboolean  touchpad_lacks_left_button (void);
+/* Whether the touchpads (or the other pointers) ignore a motion threshold */
+gboolean  pointer_threshold_ignored (gboolean touchpads);
 
 G_END_DECLS
 
