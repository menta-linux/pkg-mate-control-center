+++ b/capplets/panel/pp-window.c
@@ -0,0 +1,1433 @@
+/*
+ * pp-window.c: main window of the MATE panel properties tool
+ *
+ * Copyright (C) 2026 MATE Developers
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 of the
+ * License, or (at your option) any later version.
+ */
+
+#include <config.h>
+
+#include <stdlib.h>
+
+#include <glib/gi18n.h>
+
+#include "pp-config.h"
+#include "pp-monitors.h"
+#include "pp-panel.h"
+#include "pp-window.h"
+
+#define HELP_URI "help:mate-user-guide/gospanel-15"
+#define MIN_PANEL_SIZE 12
+#define MAX_SIZE_RATIO 5
+#define LIST_DELAY_MS 300
+#define WATCH_DELAY_MS 150
+
+#define LOCK_ICON "changes-prevent-symbolic"
+
+enum {
+	COL_LOCKED,
+	COL_LOCK_ICON,
+	COL_ICON,
+	COL_NAME,
+	COL_ID,
+	COL_EDITABLE,
+	N_COLS
+};
+
+typedef struct {
+	GtkWidget *window;
+	GtkWidget *combo;
+	GtkWidget *add_panel;
+	GtkWidget *remove_panel;
+	GtkWidget *notebook;
+	GtkWidget *general_page;
+	GtkWidget *background_page;
+	GtkWidget *applets_page;
+
+	GSettings *general;
+	GSettings *toplevel;
+	GSettings *background;
+	char      *toplevel_id;
+	gboolean   updating;
+	gboolean   panel_running;
+	gboolean   locked_down;
+	int        panel_count;
+	GtkWidget *lockdown_bar;
+	GtkWidget *reset_button;
+	guint      refresh_source;
+	guint      watch_id;
+	GPtrArray *watchers;
+
+	GPtrArray       *monitors;
+	GDBusConnection *bus;
+	guint            monitors_signal;
+
+	GtkWidget *orientation_combo;
+	GtkWidget *orientation_label;
+	GtkWidget *monitor_combo;
+	GtkWidget *monitor_label;
+	GtkWidget *size_spin;
+	GtkWidget *arrows_toggle;
+	GtkWidget *color_widgets;
+	GtkWidget *image_widgets;
+	GtkWidget *radio_none;
+	GtkWidget *radio_color;
+	GtkWidget *radio_image;
+	GtkWidget *color_button;
+	GtkWidget *opacity_scale;
+	GtkWidget *image_chooser;
+	GtkWidget *radio_tile;
+	GtkWidget *radio_scale;
+	GtkWidget *radio_stretch;
+
+	GtkWidget    *info_bar;
+	GtkWidget    *tree;
+	GtkListStore *store;
+	GtkWidget    *button_add;
+	GtkWidget    *button_remove;
+	GtkWidget    *button_edit;
+	GtkWidget    *button_lock;
+	GtkWidget    *button_up;
+	GtkWidget    *button_down;
+} PpWindow;
+
+static void rebuild_pages (PpWindow *pw);
+static void refresh_objects (PpWindow *pw);
+static void rebuild_combo (PpWindow *pw, const char *select);
+
+static void
+show_error (PpWindow *pw, const char *primary, const char *secondary)
+{
+	GtkWidget *dialog = gtk_message_dialog_new (GTK_WINDOW (pw->window),
+						    GTK_DIALOG_MODAL | GTK_DIALOG_DESTROY_WITH_PARENT,
+						    GTK_MESSAGE_ERROR, GTK_BUTTONS_CLOSE,
+						    "%s", primary);
+
+	if (secondary != NULL)
+		gtk_message_dialog_format_secondary_text (GTK_MESSAGE_DIALOG (dialog), "%s", secondary);
+
+	gtk_dialog_run (GTK_DIALOG (dialog));
+	gtk_widget_destroy (dialog);
+}
+
+static gboolean
+confirm (PpWindow *pw, const char *primary, const char *secondary, const char *action)
+{
+	GtkWidget *dialog = gtk_message_dialog_new (GTK_WINDOW (pw->window),
+						    GTK_DIALOG_MODAL | GTK_DIALOG_DESTROY_WITH_PARENT,
+						    GTK_MESSAGE_QUESTION, GTK_BUTTONS_NONE,
+						    "%s", primary);
+	int response;
+
+	gtk_message_dialog_format_secondary_text (GTK_MESSAGE_DIALOG (dialog), "%s", secondary);
+	gtk_dialog_add_button (GTK_DIALOG (dialog), _("_Cancel"), GTK_RESPONSE_CANCEL);
+	gtk_dialog_add_button (GTK_DIALOG (dialog), action, GTK_RESPONSE_ACCEPT);
+	gtk_dialog_set_default_response (GTK_DIALOG (dialog), GTK_RESPONSE_CANCEL);
+	response = gtk_dialog_run (GTK_DIALOG (dialog));
+	gtk_widget_destroy (dialog);
+
+	return response == GTK_RESPONSE_ACCEPT;
+}
+
+static GtkWidget *
+make_label (const char *text, GtkWidget *mnemonic)
+{
+	GtkWidget *label = gtk_label_new_with_mnemonic (text);
+
+	gtk_widget_set_halign (label, GTK_ALIGN_START);
+	if (mnemonic != NULL)
+		gtk_label_set_mnemonic_widget (GTK_LABEL (label), mnemonic);
+
+	return label;
+}
+
+static GtkWidget *
+named (GtkWidget *widget, const char *name)
+{
+	gtk_widget_set_name (widget, name);
+	return widget;
+}
+
+static GtkWidget *
+page_box (void)
+{
+	GtkWidget *box = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+
+	gtk_container_set_border_width (GTK_CONTAINER (box), 12);
+	return box;
+}
+
+static void
+clear_container (GtkWidget *container)
+{
+	GList *children = gtk_container_get_children (GTK_CONTAINER (container));
+	GList *l;
+
+	for (l = children; l != NULL; l = l->next)
+		gtk_widget_destroy (l->data);
+
+	g_list_free (children);
+}
+
+static GtkWidget *
+indented (GtkWidget *child)
+{
+	GtkWidget *box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+
+	gtk_widget_set_margin_start (child, 18);
+	gtk_box_pack_start (GTK_BOX (box), child, TRUE, TRUE, 0);
+	return box;
+}
+
+static void
+update_size_range (PpWindow *pw)
+{
+	const PpMonitor *monitor;
+	int orientation;
+	int max;
+
+	if (pw->size_spin == NULL || pw->monitors == NULL || pw->monitors->len == 0)
+		return;
+
+	orientation = g_settings_get_enum (pw->toplevel, "orientation");
+	monitor = pp_monitors_lookup (pw->monitors, g_settings_get_int (pw->toplevel, "monitor"));
+	if (monitor == NULL)
+		monitor = pw->monitors->pdata[0];
+
+	max = (orientation == 1 || orientation == 4 ? monitor->geometry.height
+						    : monitor->geometry.width) / MAX_SIZE_RATIO;
+	max = MAX (max, g_settings_get_int (pw->toplevel, "size"));
+	gtk_spin_button_set_range (GTK_SPIN_BUTTON (pw->size_spin), MIN_PANEL_SIZE, MAX (max, MIN_PANEL_SIZE));
+}
+
+static void
+update_orientation_sensitivity (PpWindow *pw)
+{
+	gboolean sensitive = g_settings_get_boolean (pw->toplevel, "expand") &&
+			     g_settings_is_writable (pw->toplevel, "orientation");
+
+	gtk_widget_set_sensitive (pw->orientation_combo, sensitive);
+	gtk_widget_set_sensitive (pw->orientation_label, sensitive);
+}
+
+static void
+fill_monitor_combo (PpWindow *pw)
+{
+	int current;
+	gboolean found = FALSE;
+	char *active;
+	guint i;
+
+	if (pw->monitor_combo == NULL || pw->monitors == NULL)
+		return;
+
+	current = g_settings_get_int (pw->toplevel, "monitor");
+	active = g_strdup_printf ("%d", current);
+
+	pw->updating = TRUE;
+	gtk_combo_box_text_remove_all (GTK_COMBO_BOX_TEXT (pw->monitor_combo));
+	for (i = 0; i < pw->monitors->len; i++) {
+		const PpMonitor *monitor = pw->monitors->pdata[i];
+		char *id = g_strdup_printf ("%d", monitor->index);
+		char *label = pp_monitor_label (monitor);
+
+		gtk_combo_box_text_append (GTK_COMBO_BOX_TEXT (pw->monitor_combo), id, label);
+		found = found || monitor->index == current;
+		g_free (id);
+		g_free (label);
+	}
+	if (!found) {
+		char *label = g_strdup_printf (_("Monitor %d (not connected)"), current + 1);
+
+		gtk_combo_box_text_append (GTK_COMBO_BOX_TEXT (pw->monitor_combo), active, label);
+		g_free (label);
+	}
+	gtk_combo_box_set_active_id (GTK_COMBO_BOX (pw->monitor_combo), active);
+	pw->updating = FALSE;
+
+	gtk_widget_set_sensitive (pw->monitor_combo,
+				  (pw->monitors->len > 1 || !found) &&
+				  g_settings_is_writable (pw->toplevel, "monitor"));
+	gtk_widget_set_sensitive (pw->monitor_label, gtk_widget_get_sensitive (pw->monitor_combo));
+	g_free (active);
+}
+
+static void
+monitor_combo_changed_cb (GtkComboBox *combo, PpWindow *pw)
+{
+	const char *active = gtk_combo_box_get_active_id (combo);
+	const PpMonitor *monitor;
+
+	if (pw->updating || active == NULL)
+		return;
+
+	monitor = pp_monitors_lookup (pw->monitors, atoi (active));
+	if (monitor != NULL && monitor->index != g_settings_get_int (pw->toplevel, "monitor"))
+		pp_monitors_assign (pw->toplevel, monitor);
+}
+
+static gboolean
+same_monitors (GPtrArray *a, GPtrArray *b)
+{
+	guint i;
+
+	if (a == NULL || b == NULL || a->len != b->len)
+		return FALSE;
+	for (i = 0; i < a->len; i++) {
+		const PpMonitor *x = a->pdata[i];
+		const PpMonitor *y = b->pdata[i];
+
+		if (x->index != y->index || x->primary != y->primary ||
+		    g_strcmp0 (x->id, y->id) != 0 || g_strcmp0 (x->connector, y->connector) != 0 ||
+		    g_strcmp0 (x->name, y->name) != 0 ||
+		    !gdk_rectangle_equal (&x->geometry, &y->geometry))
+			return FALSE;
+	}
+	return TRUE;
+}
+
+static void
+refresh_monitors (PpWindow *pw)
+{
+	GPtrArray *monitors = pp_monitors_new (gtk_widget_get_display (pw->window));
+
+	if (same_monitors (pw->monitors, monitors)) {
+		g_ptr_array_unref (monitors);
+		return;
+	}
+
+	if (pw->monitors != NULL)
+		g_ptr_array_unref (pw->monitors);
+	pw->monitors = monitors;
+	update_size_range (pw);
+	fill_monitor_combo (pw);
+	rebuild_combo (pw, pw->toplevel_id);
+}
+
+static void
+toplevel_changed_cb (GSettings *settings, const char *key, PpWindow *pw)
+{
+	if (g_strcmp0 (key, "expand") == 0)
+		update_orientation_sensitivity (pw);
+
+	if (g_strcmp0 (key, "monitor") == 0)
+		fill_monitor_combo (pw);
+
+	if (g_strcmp0 (key, "orientation") == 0 || g_strcmp0 (key, "monitor") == 0)
+		update_size_range (pw);
+
+	if (g_strcmp0 (key, "orientation") == 0 || g_strcmp0 (key, "monitor") == 0 ||
+	    g_strcmp0 (key, "name") == 0)
+		rebuild_combo (pw, pw->toplevel_id);
+}
