#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk

%:
	dh $@ --buildsystem=meson --without autoreconf

override_dh_missing:
	dh_missing --fail-missing

override_dh_install:
	rm -rfv debian/tmp/usr/share/applications/mimeinfo.cache
	rm -rfv debian/tmp/usr/lib/*/*.la
	rm -rfv debian/tmp/usr/lib/*/*/*.la
	dh_install

# The meson build auto-detects Wayland (wayland-client, gtk+-wayland-3.0,
# wayland-protocols, wayland-scanner), needed by the typing-break Wayland
# idle monitor; those are Build-Depends, so it is always on here.
# This upstream release has no in-process option.
override_dh_auto_configure:
	dh_auto_configure -- \
		-Daccountsservice=enabled

override_dh_installchangelogs:
	dh_installchangelogs NEWS

get-orig-source:
	uscan --noconf --force-download --rename --download-current-version --destdir=..
