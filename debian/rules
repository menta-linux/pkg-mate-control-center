#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk

%:
	dh $@ --buildsystem=meson --without autoreconf

override_dh_missing:
	dh_missing --fail-missing

override_dh_install:
	rm -rfv debian/tmp/usr/share/applications/mimeinfo.cache
	rm -rfv debian/tmp/usr/lib/*/*.la
	rm -rfv debian/tmp/usr/lib/*/*/*.la
	dh_install

# Wayland support is forced on: configure must FAIL (not silently skip) if
# wayland-client, wayland-scanner or mate-wayland-protocols (from
# libmate-desktop-dev) are missing.  gtk-layer-shell (monitor labels in the
# display capplet) is a hard Build-Depends too.
override_dh_auto_configure:
	dh_auto_configure -- \
		-Daccountsservice=enabled \
		-Dwayland=enabled

override_dh_installchangelogs:
	dh_installchangelogs NEWS

get-orig-source:
	uscan --noconf --force-download --rename --download-current-version --destdir=..
